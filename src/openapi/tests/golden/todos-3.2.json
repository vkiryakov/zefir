{
  "openapi": "3.2.1",
  "info": {
    "title": "Todos API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "tags": [
    {
      "name": "Todos",
      "description": "The todos of the inbox and of the lists."
    }
  ],
  "paths": {
    "/v1/todos/{id}": {
      "get": {
        "operationId": "Todos.get",
        "tags": [
          "Todos"
        ],
        "summary": "Get a todo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the todo.",
            "example": 1,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "InvalidRequest": {
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "code": "invalid_request",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "TodoNotFound": {
                    "value": {
                      "type": "about:blank",
                      "title": "Todo not found",
                      "status": 404,
                      "code": "todos.not_found",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "ValidationFailed": {
                    "value": {
                      "type": "about:blank",
                      "title": "Unprocessable Content",
                      "status": 422,
                      "code": "validation_failed",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "internal": {
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "code": "internal",
                      "errors": []
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "Todos.delete",
        "tags": [
          "Todos"
        ],
        "summary": "Delete a todo",
        "description": "A todo that is locked or archived stays.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the todo.",
            "example": 1,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "InvalidRequest": {
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "code": "invalid_request",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "ListNotFound": {
                    "value": {
                      "type": "about:blank",
                      "title": "List not found",
                      "status": 404,
                      "code": "lists.not_found",
                      "errors": []
                    }
                  },
                  "TodoNotFound": {
                    "value": {
                      "type": "about:blank",
                      "title": "Todo not found",
                      "status": 404,
                      "code": "todos.not_found",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "TodoArchived": {
                    "value": {
                      "type": "about:blank",
                      "title": "The todo cannot change",
                      "status": 409,
                      "code": "todos.frozen",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "ValidationFailed": {
                    "value": {
                      "type": "about:blank",
                      "title": "Unprocessable Content",
                      "status": 422,
                      "code": "validation_failed",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "internal": {
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "code": "internal",
                      "errors": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/todos": {
      "post": {
        "operationId": "Todos.create",
        "tags": [
          "Todos"
        ],
        "summary": "Create a todo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodoRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The todo it made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "InvalidRequest": {
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "code": "invalid_request",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "ListNotFound": {
                    "value": {
                      "type": "about:blank",
                      "title": "List not found",
                      "status": 404,
                      "code": "lists.not_found",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "PayloadTooLarge": {
                    "value": {
                      "type": "about:blank",
                      "title": "Content Too Large",
                      "status": 413,
                      "code": "payload_too_large",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "UnsupportedMediaType": {
                    "value": {
                      "type": "about:blank",
                      "title": "Unsupported Media Type",
                      "status": 415,
                      "code": "unsupported_media_type",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "ValidationFailed": {
                    "value": {
                      "type": "about:blank",
                      "title": "Unprocessable Content",
                      "status": 422,
                      "code": "validation_failed",
                      "errors": []
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "internal": {
                    "value": {
                      "type": "about:blank",
                      "title": "Internal Server Error",
                      "status": 500,
                      "code": "internal",
                      "errors": []
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTodoRequest": {
        "type": "object",
        "description": "A new todo.",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "What to do. Leading and trailing spaces are removed.",
            "pattern": "[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]",
            "maxLength": 200
          },
          "listId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "description": "The list of the todo; none for the inbox.",
            "minimum": 1,
            "default": null,
            "examples": [
              1
            ]
          }
        },
        "additionalProperties": false,
        "examples": [
          {
            "title": "Buy milk",
            "listId": null
          }
        ]
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "errors"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Violation"
            }
          }
        }
      },
      "TodoResponse": {
        "type": "object",
        "description": "A todo, as the API shows it.",
        "required": [
          "id",
          "title",
          "done"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64",
            "description": "The id of the todo.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "What to do."
          },
          "done": {
            "type": "boolean",
            "description": "Whether it is done."
          }
        }
      },
      "Violation": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        }
      }
    }
  }
}
