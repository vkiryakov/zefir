  },
  {
    "id": "custom-014",
    "rule": "custom",
    "params": "\"numbers.even\", \"must be even\", isEven",
    "call": "v.custom(\"numbers.even\", \"must be even\", isEven).withMessage(\"pick an even number\")",
    "field_type": "u32",
    "input": "1",
    "expect": "fail",
    "code": "numbers.even",
    "message": "pick an even number",
    "reason": "withMessage replaces the literal message of custom and keeps its code",
    "source": "errata VE-268"
  },
  {
    "id": "each-001",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const u32",
    "input": [
      "1",
      "0"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "message": "must be greater than 0",
    "path": "[1]",
    "reason": "each runs its rule on every item; the path ends in the failing index",
    "source": "errata VE-246"
  },
  {
    "id": "each-002",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const ?u32",
    "input": [
      null,
      "0"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "message": "must be greater than 0",
    "path": "[1]",
    "reason": "null items are skipped and keep their index",
    "source": "errata VE-247"
  },
  {
    "id": "each-003",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const ?u32",
    "input": [
      null
    ],
    "expect": "pass",
    "reason": "a list of null items passes",
    "source": "errata VE-248",
    "deviation": "D63"
  },
  {
    "id": "each-004",
    "rule": "each",
    "params": "v.each(v.positive)",
    "field_type": "[]const []const u32",
    "input": [
      [
        "1"
      ],
      [
        "0",
        "1"
      ]
    ],
    "expect": "fail",
    "code": "validation.positive",
    "message": "must be greater than 0",
    "path": "[1][0]",
    "reason": "each(each(r)) runs r once on every inner item",
    "source": "errata VE-255"
  },
  {
    "id": "each-005",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const u32",
    "input": [
      "0",
      "1",
      "0"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "path": "[0]",
    "mode": "checkAll",
    "violations": [
      {
        "code": "validation.positive",
        "path": "[0]"
      },
      {
        "code": "validation.positive",
        "path": "[2]"
      }
    ],
    "reason": "checkAll reports one violation per failing item; check returns the first",
    "source": "errata VE-257"
  },
  {
    "id": "each-006",
    "rule": "each",
    "params": "v.notEmpty",
    "field_type": "[]const []const u8",
    "input": [
      "a",
      "",
      "b"
    ],
    "expect": "fail",
    "code": "validation.not_empty",
    "message": "must not be empty",
    "path": "[1]",
    "reason": "notEmpty runs on every string item; the empty item fails at its index",
    "source": "errata VE-521"
  },
  {
    "id": "each-007",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[3]u32",
    "input": [
      "1",
      "2",
      "0"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "message": "must be greater than 0",
    "path": "[2]",
    "reason": "an array is walked like a slice: item rules run on every element",
    "source": "errata VE-522"
  },
  {
    "id": "each-008",
    "rule": "each",
    "params": ".{ v.notEmpty, v.custom(\"users.handle\", \"must start with @\", startsWithAt) }",
    "field_type": "[]const []const u8",
    "input": [
      "@a",
      ""
    ],
    "expect": "fail",
    "code": "validation.not_empty",
    "message": "must not be empty",
    "path": "[1]",
    "reason": "item rules run left to right: notEmpty fails first, so the custom rule does not run",
    "source": "errata VE-523"
  },
  {
    "id": "each-009",
    "rule": "each",
    "params": ".{ v.notEmpty, v.custom(\"users.handle\", \"must start with @\", startsWithAt) }",
    "field_type": "[]const []const u8",
    "input": [
      "@a",
      "b"
    ],
    "expect": "fail",
    "code": "users.handle",
    "message": "must start with @",
    "path": "[1]",
    "reason": "the second item rule runs when the first passes",
    "source": "errata VE-524"
  },
  {
    "id": "each-010",
    "rule": "each",
    "params": "v.positive",
    "field_type": "?[]const u32",
    "input": null,
    "expect": "pass",
    "reason": "a null list skips its rules and its items",
    "source": "errata VE-525"
  },
  {
    "id": "each-011",
    "rule": "each",
    "params": "v.each(v.notEmpty)",
    "field_type": "[]const []const []const u8",
    "input": [
      [
        "a"
      ],
      [
        "b",
        ""
      ]
    ],
    "expect": "fail",
    "code": "validation.not_empty",
    "message": "must not be empty",
    "path": "[1][1]",
    "reason": "each(each(r)) reaches the strings of a nested list; the path has both indices",
    "source": "errata VE-526"
  },
  {
    "id": "each-012",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const ?u32",
    "input": [
      "0",
      null,
      "0",
      "1"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "path": "[0]",
    "mode": "checkAll",
    "violations": [
      {
        "code": "validation.positive",
        "path": "[0]"
      },
      {
        "code": "validation.positive",
        "path": "[2]"
      }
    ],
    "reason": "checkAll reports every failing item; null items are skipped and keep their index",
    "source": "errata VE-527"
  },
  {
    "id": "each-013",
    "rule": "each",
    "params": "v.positive",
    "field_type": "[]const u32",
    "input": [],
    "expect": "pass",
    "reason": "an empty list has no items to check",
    "source": "errata VE-528"
  },
  {
    "id": "each-014",
    "rule": "each",
    "params": "v.positive",
    "call": ".{ v.maxItems(2), v.each(v.positive) }",
    "field_type": "[]const u32",
    "input": [
      "0",
      "0",
      "0"
    ],
    "expect": "fail",
    "code": "validation.max_items",
    "message": "must have at most 2 items",
    "reason": "a failing list rule stops the walk: each never sees the items",
    "source": "errata VE-249"
  },
  {
    "id": "each-015",
    "rule": "each",
    "params": "v.oneOf(.{ \"red\", \"green\" })",
    "field_type": "[]const []const u8",
    "input": [
      "red",
      "blue"
    ],
    "expect": "fail",
    "code": "validation.one_of",
    "message": "must be one of: red, green",
    "path": "[1]",
    "reason": "each runs oneOf on every string item; the path ends in the index",
    "source": "errata VE-250"
  },
  {
    "id": "each-016",
    "rule": "each",
    "params": "v.noneOf(.{.guest})",
    "field_type": "[]const Role",
    "input": [
      ".admin",
      ".guest"
    ],
    "expect": "fail",
    "code": "validation.none_of",
    "message": "must not be guest",
    "path": "[1]",
    "reason": "each runs noneOf on every enum item; one value says \"must not be guest\"",
    "source": "errata VE-251"
  },
  {
    "id": "each-017",
    "rule": "each",
    "params": "v.divisibleBy(15)",
    "field_type": "[]const u32",
    "input": [
      "0",
      "15",
      "20",
      "45"
    ],
    "expect": "fail",
    "code": "validation.divisible_by",
    "message": "must be divisible by 15",
    "path": "[2]",
    "reason": "each runs divisibleBy on every item; the first failing index is reported",
    "source": "errata VE-252"
  },
  {
    "id": "each-018",
    "rule": "each",
    "params": "v.positive.withMessage(\"must be a positive id\")",
    "field_type": "[]const u32",
    "input": [
      "1",
      "0"
    ],
    "expect": "fail",
    "code": "validation.positive",
    "message": "must be a positive id",
    "path": "[1]",
    "reason": "an item rule with withMessage reports its own message at the index",
