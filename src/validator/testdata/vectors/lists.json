[
  {
    "id": "custom-001",
    "rule": "custom",
    "params": "\"numbers.even\", \"must be even\", isEven",
    "field_type": "u32",
    "input": "3",
    "expect": "fail",
    "code": "numbers.even",
    "message": "must be even",
    "reason": "the predicate returns false for an odd number",
    "source": "errata VE-258"
  },
  {
    "id": "custom-002",
    "rule": "custom",
    "params": "\"numbers.even\", \"must be even\", isEven",
    "field_type": "u32",
    "input": "4",
    "expect": "pass",
    "reason": "the predicate returns true for an even number",
    "source": "errata VE-259"
  },
  {
    "id": "custom-003",
    "rule": "custom",
    "params": "\"numbers.even\", \"must be even\", isEvenPtr",
    "field_type": "u32",
    "input": "3",
    "expect": "fail",
    "code": "numbers.even",
    "message": "must be even",
    "reason": "a predicate may take the value by *const",
    "source": "errata VE-260"
  },
  {
    "id": "custom-004",
    "rule": "custom",
    "params": "\"numbers.even\", \"must be even\", isEvenPtr",
    "field_type": "u32",
    "input": "4",
    "expect": "pass",
    "reason": "the *const predicate passes an even number",
    "source": "errata VE-261"
  },
  {
    "id": "custom-005",
    "rule": "custom",
    "params": "\"orders.out_of_stock\", \"must be in stock\", hasStock",
    "field_type": "Stock",
    "input": {
      "sku": "ABCDEFGH",
      "qty": "0"
    },
    "expect": "fail",
    "code": "orders.out_of_stock",
    "message": "must be in stock",
    "reason": "a predicate may take a whole struct",
    "source": "errata VE-262"
  },
  {
    "id": "custom-006",
    "rule": "custom",
    "params": "\"orders.out_of_stock\", \"must be in stock\", hasStock",
    "field_type": "?Stock",
    "input": null,
    "expect": "pass",
    "reason": "null skips the rule",
    "source": "errata VE-263"
  },
  {
    "id": "custom-007",
    "rule": "custom",
    "params": "\"users.handle\", \"must start with @\", startsWithAt",
    "field_type": "[]const u8",
    "input": "bob",
    "expect": "fail",
    "code": "users.handle",
    "message": "must start with @",
    "reason": "a predicate on a string field",
    "source": "errata VE-264"
  },
  {
    "id": "custom-008",
    "rule": "custom",
    "params": "\"numbers.small\", \"must be small\", lt100",
    "call": ".{ v.custom(\"numbers.small\", \"must be small\", lt100), v.custom(\"numbers.even\", \"must be even\", isEven) }",
    "field_type": "u32",
    "input": "101",
    "expect": "fail",
    "code": "numbers.small",
    "message": "must be small",
    "reason": "the first failing rule is the only violation",
    "source": "errata VE-265"
  },
  {
    "id": "custom-009",
    "rule": "custom",
    "params": "\"numbers.small\", \"must be small\", lt100",
    "call": ".{ v.custom(\"numbers.small\", \"must be small\", lt100), v.custom(\"numbers.even\", \"must be even\", isEven) }",
    "field_type": "u32",
    "input": "51",
    "expect": "fail",
    "code": "numbers.even",
    "message": "must be even",
    "reason": "the second rule runs when the first passes",
    "source": "errata VE-266"
  },
  {
    "id": "custom-010",
    "rule": "custom",
    "params": "\"numbers.small\", \"must be small\", lt100",
    "call": ".{ v.custom(\"numbers.small\", \"must be small\", lt100), v.custom(\"numbers.even\", \"must be even\", isEven) }",
    "field_type": "u32",
    "input": "50",
    "expect": "pass",
    "reason": "a value that passes both rules",
    "source": "errata VE-267"
  },
  {
    "id": "custom-011",
    "rule": "custom",
    "params": "\"text.non_empty\", \"must not be empty\", isNonEmpty",
    "field_type": "[:0]const u8",
    "input": "",
