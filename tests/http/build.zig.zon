.{
    .name = .zefir_http_tests,
    .version = "0.0.0",
    .fingerprint = 0xea0eb3d530080910,
    .minimum_zig_version = "0.17.0",
    // A package of its own, outside zefir's `.paths`: users of zefir never
    // fetch zio.
    .dependencies = .{
        .zefir = .{ .path = "../.." },
        // zio has no release for Zig 0.17 yet: a commit of its main branch.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#d15034f1a4d9ddaa42829aae8f7e02d37cd1093a",
            .hash = "zio-0.19.0-xHbVVOh_LAARremJ6LB0458m2qh22szKGX2l175yUu90",
        },
    },
    .paths = .{""},
}
